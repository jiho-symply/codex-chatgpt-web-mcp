{
  "name": "codex-chatgpt-web-mcp",
  "version": "0.9.0",
  "description": "Use authenticated ChatGPT Web as a browser-backed MCP backend for OpenAI Codex without exposing the workspace to ChatGPT.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "cgw": "bin/cgw.mjs",
    "codex-chatgpt-web-mcp": "bin/cgw.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^14.0.0",
    "playwright": "^1.55.0",
    "zod": "^3.25.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiho-symply/codex-chatgpt-web-mcp.git"
  },
  "keywords": [
    "codex",
    "mcp",
    "chatgpt",
    "chatgpt-web",
    "playwright",
    "browser-automation",
    "coding-agent"
  ],
  "homepage": "https://github.com/jiho-symply/codex-chatgpt-web-mcp#readme",
  "bugs": {
    "url": "https://github.com/jiho-symply/codex-chatgpt-web-mcp/issues"
  },
  "files": [
    "bin/",
    "src/",
    "docs/",
    "LICENSE",
    "README.md",
    "README.ko-KR.md",
    "SECURITY.md",
    "tsconfig.json"
  ],
  "publishConfig": {
    "access": "public"
  }
}
